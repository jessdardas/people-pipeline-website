<?xml version="1.0" encoding="utf-8"?>
<!-- PEOPLE PIPELINE website - IIS settings -->
<configuration>
  <system.web>
    <compilation targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- IIS doesn't serve these file types unless they are listed -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".xlsx" />
      <mimeMap fileExtension=".xlsx" mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- always the newest data and code -->
        <add name="Cache-Control" value="no-cache" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- the saved settings, the helper scripts and the source copies are not downloadable -->
          <add segment="App_Data" />
          <add segment="tools" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
